extends "res://tests/suites/battle_suite.gd"
const AURA = preload("res://scripts/battle/debuff_aura_system.gd")
func run(harness: Object) -> void:
	_harness = harness
	for field in ["debuff_aura_radius", "debuff_aura_active_radius", "debuff_aura_move_multiplier", "debuff_aura_attack_multiplier"]:
		for invalid in [0.0, -1.0, INF, "wrong", [], null]:
			var broken := CardDB.get_card("pillar_of_ice").duplicate(true)
			broken[field] = invalid
			_expect(not CardDB.VALIDATOR.validate_all({"pillar_of_ice": broken}, false).is_empty(), "减益光环拒绝非法字段：" + field)
	_main = preload("res://tests/fixtures/authority_battle.gd").new()
	harness.root.add_child(_main)
	var pillar := _spawn_ready_unit("pillar_of_ice", 0, Vector2(300, 900))
	var enemy := _spawn_ready_unit("garen", 1, Vector2(350, 900))
	var ally := _spawn_ready_unit("garen", 0, Vector2(350, 900))
	var actors: Array = [pillar, enemy, ally]
	var stats := CardDB.get_card("pillar_of_ice")
	_expect(stats.footprint_tiles == Vector2i(3, 3) and pillar.body_radius == 21.0, "冰柱3×3占地、稍大体型")
	_expect(stats.cost == 3 and stats.lifespan == 20.0 and stats.hp == 600, "冰柱费用与寿命")
	_expect(_main.runtime._deployment_rules.is_card_deploy_position_valid(0, "pillar_of_ice", Vector2(300, 400)), "全图部署敌方半区")
	AURA.update(actors)
	_expect(is_equal_approx(enemy._effective_movement_multiplier(), 0.7) and is_equal_approx(enemy._effective_attack_speed_multiplier(), 0.75), "敌军双减速")
	_expect(ally._effective_movement_multiplier() == 1.0 and ally._effective_attack_speed_multiplier() == 1.0, "不影响友军")
	_expect(enemy.movement_slow_visual() and enemy.attack_speed_slow_visual(), "通用减益提示")
	enemy.position = pillar.position + Vector2(110 + enemy.body_radius, 0)
	AURA.update(actors)
	_expect(enemy.movement_slow_visual(), "身体圆触及边界受影响")
	enemy.position.x += 0.1
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "离开即清除")
	pillar.apply_active_buff(5.0, 1.0, 1.0, 1.0)
	AURA.update(actors)
	_expect(enemy.movement_slow_visual(), "主动扩大至5格")
	pillar._tick_active_statuses(5.0)
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "5秒主动到期恢复110半径")
	enemy.position = pillar.position + Vector2(60, 0)
	var second := _spawn_ready_unit("pillar_of_ice", 0, Vector2(240, 900))
	actors.append(second)
	AURA.update(actors)
	_expect(is_equal_approx(enemy._effective_attack_speed_multiplier(), 0.75), "多柱同类取最强不叠乘")
	enemy.apply_slow(3.0, 0.5, &"test_other")
	enemy.apply_attack_speed_slow(3.0, 0.6, &"test_other")
	AURA.update(actors)
	_expect(is_equal_approx(enemy._effective_movement_multiplier(), 0.5) and is_equal_approx(enemy._effective_attack_speed_multiplier(), 0.6), "与其他减益取最强")
	pillar.hp = 0
	second.hp = 0
	AURA.update(actors)
	_expect(enemy.control.modifiers.remaining(&"slow") > 0.0 and enemy.control.slow_multiplier == 0.5, "光环消失不删除其他来源")
	enemy.control.modifiers.clear_family(&"slow")
	enemy.control.modifiers.clear_family(&"attack_slow")
	pillar.hp = 600
	pillar.apply_stasis(1.0)
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "来源凝滞关闭光环")
	pillar.control.hard.clear_family(&"stasis")
	pillar.stun(1.0)
	AURA.update(actors)
	_expect(enemy.movement_slow_visual(), "眩晕不关闭被动光环")
	enemy.apply_control_immunity(1.0, true, &"test")
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual() and not enemy.attack_speed_slow_visual(), "控制免疫拒绝双减速")
	enemy.buffs.clear_family(&"control_immunity")
	enemy.apply_stasis(1.0)
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "目标凝滞不接收光环")
	enemy.control.hard.clear_family(&"stasis")
	pillar._deploy_timer = 0.5
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "部署期间不提前施加")
	pillar._deploy_timer = 0
	AURA.update(actors)
	actors.erase(pillar)
	AURA.update(actors)
	_expect(not enemy.movement_slow_visual(), "来源移除立即失效")
	var view = load("res://assets/units/pillar_of_ice/pillar_view.tscn").instantiate()
	harness.root.add_child(view)
	view.configure_unit_visual(pillar)
	view.advance_deployment_visual(0.0, 1.0, true)
	var rise_start: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	view.advance_deployment_visual(0.36, 1.0, true)
	var rise_end: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(rise_end[2] - rise_start[2] > 200.0, "原生柱体从地下升起，0.36秒到稳定高度")
	view._process(4.0)
	var idle: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(is_equal_approx(idle[2], rise_end[2]), "延长待机不重复升降主体")
	_expect(is_equal_approx(view._pillar.scale.x, 0.009), "主体统一缩放0.009")
	_expect(is_equal_approx(view._ring.scale.x * 40.0, 110.0), "基础红蓝圈半径与权威110一致")
	_expect(view._pillar._data.emitters.size() == 7, "保留截图六层并恢复地面暗底")
	for emitter in ["ice_pillar", "Splash_Out", "rays", "base_glow"]:
		_expect(is_equal_approx(view._pillar.emitter_scale(emitter), 1.0), "贴柱层跟随模型：" + emitter)
	_expect(is_equal_approx(view._pillar.emitter_scale("ice_cracks") * 0.009 * 330.0 * 40.0, 110.0), "裂纹地面半径110")
	_expect(is_equal_approx(view._pillar.emitter_scale("smoke_fall") * 0.009 * 400.0 * 40.0, 110.0), "冷雾分布半径110")
	_expect(is_equal_approx(view._pillar.emitter_scale("black_circle") * 0.009 * 425.0 * 40.0, 110.0), "暗底可见边缘匹配110范围")
	var audio_events: Dictionary = stats.audio.events
	_expect(audio_events.has("deploy:start") and audio_events.has("death") and audio_events.has("idle:sustain"), "E升起/落下分别部署与死亡，W持续声用于待机")
	_expect(audio_events.has("active_buff:start") and not audio_events.has("active_buff:sustain"), "W开启仅播放一次，无额外持续循环")
	for cue in audio_events:
		_expect(audio_events[cue].pool.size() == 1, "冰柱音效只保留一段，无随机变体：" + cue)
	var invalid_audio := stats.duplicate(true)
	invalid_audio.audio.events["death"]["owner"] = "unit"
	_expect(not CardDB.VALIDATOR.validate_all({"pillar_of_ice": invalid_audio}, false).is_empty(), "死亡结果音不允许归属已死亡单位")
	var body_scale: Vector3 = view._pillar.scale
	pillar.apply_active_buff(5.0, 1.0, 1.0, 1.0)
	view._process(0.0)
	_expect(is_equal_approx(view._ring.scale.x * 40.0, 200.0) and view._pillar.scale == body_scale, "扩圈只扩大内部范围粒子，不扩大主体")
	_expect(is_equal_approx(view._pillar.emitter_scale("base_glow"), 1.0) and is_equal_approx(view._pillar.emitter_scale("Splash_Out"), 1.0), "扩圈不拉大底光和升起喷溅")
	_expect(is_equal_approx(view._pillar.emitter_scale("ice_cracks") * 0.009 * 330.0 * 40.0, 200.0), "主动裂纹半径200")
	_expect(is_equal_approx(view._pillar.emitter_scale("black_circle") * 0.009 * 425.0 * 40.0, 200.0), "暗底可见边缘匹配主动200范围")
	pillar._tick_active_statuses(5.0)
	view._process(12.0)
	_expect(view._pillar._age > 15.0, "常驻时间连续推进，不回放1至3秒")
	var smoke_count := 0
	for item in view._pillar._pools[3]:
		if item.visible: smoke_count += 1
	_expect(smoke_count > 0, "超过原版6秒后仍连续发射烟雾")
	view._process(8.0)
	_expect(view._pillar._age >= 27.0, "治疗延寿进入连续粒子周期")
	view._process(20.0)
	var late_smoke := 0
	for item in view._pillar._pools[3]:
		if item.visible: late_smoke += 1
	_expect(late_smoke > 0 and view._pillar._age < 47.0, "第二个周期仍有烟雾，不停在末帧")
	view.set_preview_team(1)
	_expect(view._ring.material_override.get_shader_parameter("rim_color") == Color(1.0, 0.25, 0.20), "敌方范围复用项目红圈")
	view.begin_visual_death(0.8)
	view._process(0.4)
	_expect(not view._ring.visible and view._pillar.visible, "死亡立即关闭范围并保留退场")
	var sinking: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(sinking[2] < idle[2] - 100.0, "死亡立即沿原曲线下沉")
	view._process(0.35)
	var sunk: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(sunk[2] + 338.982 < 0.0, "退场前整个原生网格已下沉到地面以下")
	view.finish_visual_death()
	_expect(not view._pillar.visible, "退场清理柱体")
	view.reset_pool_visual()
	var anim: AnimationPlayer = view.get_node("AnimationPlayer")
	anim.play("Rise")
	anim.seek(0.1, true)
	view._process(0.0)
	var preview_rise: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(preview_rise[2] > rise_start[2] and preview_rise[2] < rise_end[2], "Rise预览轨道读取真实源姿态")
	anim.play("Death")
	anim.seek(0.75, true)
	view._process(0.0)
	var preview_death: PackedFloat32Array = view._pillar._pools[0][0].material_override.get_shader_parameter("p")
	_expect(preview_death[2] + 338.982 < 0.0, "Death预览轨道不是空时间窗口")
	view.free()
	_main.free()
