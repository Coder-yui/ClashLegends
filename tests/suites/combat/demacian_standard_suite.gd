extends "res://tests/suites/battle_suite.gd"
const AURA = preload("res://scripts/battle/haste_aura_system.gd")
func run(harness: Object) -> void:
	_harness = harness
	_main = preload("res://tests/fixtures/authority_battle.gd").new()
	harness.root.add_child(_main)
	var aegis = load("res://assets/effects/demacian_standard/golden_aegis.tscn").instantiate()
	harness.root.add_child(aegis)
	aegis.configure(22.5, 0)
	var max_scale := 0.0
	for frame in aegis._nova._data.frames:
		for emitter in frame:
			for particle in emitter:
				if float(particle[10]) > 0.001: max_scale = maxf(max_scale, maxf(float(particle[4]), float(particle[6])))
	var reached := minf(153.06227423519815 * max_scale, aegis._nova.range_radius) * float(aegis._nova.scale.x) * 40.0
	var visible_ring := 153.06227423519815 * 3.0 * float(aegis._nova.scale.x) * 40.0
	_expect(is_equal_approx(visible_ring, 160.0), "W可见主环而非透明尾帧对齐160")
	_expect(is_equal_approx(aegis._nova.position.y + 10.0 * aegis._nova.scale.x, 0.025), "W扩散面与常驻范围面同高")
	_expect(reached <= 160.01 and reached >= 159.0, "W完整扩张外沿对齐160技能中心边界")
	aegis.shield_active = true
	aegis.on_cue(&"shield:cast")
	aegis.advance_status(true, true, 0.2)
	_expect(is_equal_approx(aegis._shield._age, 0.2), "W新版盾入场使用源时间，不将5.1秒整段加速")
	aegis.advance_status(true, true, 2.6)
	_expect(is_equal_approx(aegis._shield._age, 2.8) and aegis._shield.visible, "W临近结束仍保留原速且淡出")
	aegis.advance_status(true, true, 0.21)
	_expect(not aegis._shield.visible, "W表现不越过项目3秒盾期")
	aegis.free()
	var effects := SkillEffectPresentation.new(_main)
	effects.present_area_shield("demacian_standard", 0, Vector2.ZERO)
	_expect(effects.shield_effects.is_empty(), "军旗范围盾不混入太阳圆盘烈阳之匣")
	effects.present_area_shield("sun_disc", 0, Vector2.ZERO)
	_expect(effects.shield_effects.size() == 1, "太阳圆盘明确声明的烈阳之匣仍正常播放")
	var flag := _spawn_ready_unit("demacian_standard", 0, Vector2(300, 900))
	_expect(flag.body_radius == 18.0 and float(CardDB.get_card("demacian_standard").deploy_time) == 1.0, "军旗中体型并保留1秒部署")
	var view = load("res://assets/units/demacian_standard/standard_view.tscn").instantiate()
	harness.root.add_child(view)
	view.configure_unit_visual(flag)
	view._sync_flag_attachment()
	_expect(view.flag.global_transform.is_equal_approx(view._skeleton.global_transform * view._skeleton.get_bone_global_pose(view._root_bone)), "旗面跟随源root骨骼方向及缩放")
	view.flag.seek(2.5)
	var cloth: Mesh = view.flag._trails[0].mesh
	var cloth_vertices: PackedVector3Array = cloth.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
	_expect(absf(cloth_vertices[0].x) < 0.001 and absf(cloth_vertices[1].x) < 0.001 and absf(cloth_vertices[0].z) < 0.001 and absf(cloth_vertices[1].z) < 0.001 and absf(cloth_vertices[0].y - cloth_vertices[1].y) > 30.0, "旗面缝合边沿杆身形成竖直线接触")
	view.set_preview_team(0)
	var blue: Color = view._aura.material_override.get_shader_parameter("edge_tint")
	view.set_preview_team(1)
	var red: Color = view._aura.material_override.get_shader_parameter("edge_tint")
	_expect(blue.b > blue.r and red.r > red.b, "范围边缘按双方阵营区分红蓝")
	var materials := ModelVisualResources.new()
	materials.bind_model(view)
	materials.apply_overlays(true, false, false)
	_expect(view._aura.material_overlay == null, "范围透明平面不接受受击白闪，避免整块显形")
	_expect(materials._meshes.size() == 1 and materials._meshes.all(func(mesh): return not mesh.is_in_group("presentation_fx")), "仅实体模型接受受击材质，排除旗面及范围层")
	materials.clear()
	view.advance_deployment_visual(0.25, 1.0, true)
	_expect(not view.get_node("Model").visible and is_instance_valid(view._fall) and not view.flag.visible, "下落期间使用E武器且隐藏落地模型")
	_expect(absf(float(view._fall._data.frames[0][0][0][2]) - 2000.0) < 0.01 and absf(float(view._fall._data.frames[60][0][0][2])) < 0.01, "E原版2000高度与4000下落速度在0.5秒准时落地")
	view.advance_deployment_visual(0.5, 1.0, true)
	_expect(view.get_node("Model").visible and view.flag.visible and not is_instance_valid(view._fall) and is_instance_valid(view._landing), "半秒落地切换旗杆旗面及E命中特效")
	for i in view._landing._data.emitters.size():
		var emitter: Dictionary = view._landing._data.emitters[i]
		if emitter.name == "smoke":
			var mat: ShaderMaterial = view._landing._materials[i]
			_expect(bool(mat.get_shader_parameter("fixed_alpha_uv")), "部署烟雾固定透明轮廓不随RGB纹理滚动")
			_expect(bool(mat.get_shader_parameter("has_soft")), "部署烟雾启用地面软交界")
	view.advance_deployment_visual(0.9, 1.0, true)
	_expect(view.get_node("Model").visible and view.flag.visible, "部署剩余时间由待机补齐")
	view.advance_deployment_visual(1.0, 1.0, true)
	_expect(is_instance_valid(view._landing) and view.get_node("Model").visible, "部署结束保留原版落地尾部不延长权威部署")
	view._process(0.7)
	_expect(not is_instance_valid(view._landing), "落地尾部自然结束后清理")
	view.reset_pool_visual()
	view.configure_unit_visual(flag)
	view.advance_deployment_visual(1.0, 1.0, true)
	_expect(not is_instance_valid(view._fall), "重连不补播已完成下落")
	view.reset_pool_visual()
	view.advance_deployment_visual(0.2, 1.0, true)
	view.advance_deployment_visual(0.3, 1.0, false)
	_expect(not is_instance_valid(view._fall), "取消部署清理下落粒子")
	flag._deploy_timer = 0.0
	view.configure_unit_visual(flag)
	view._process(0.0)
	_expect(view._aura.visible and is_equal_approx(view._aura.scale.x, 4.0), "攻速常驻圈按160中心半径显示")
	flag._deploy_timer = 0.5
	view._process(0.0)
	_expect(not view._aura.visible, "部署期间不显示未生效光环")
	flag._deploy_timer = 0.0
	flag.apply_stasis(1.0)
	view._process(0.0)
	_expect(not view._aura.visible, "凝滞期间隐藏失效范围")
	flag._tick_active_statuses(1.0)
	view.reset_pool_visual()
	view.advance_deployment_visual(0.25, 1.0, true)
	view.advance_deployment_visual(1.0, 1.0, true)
	view._process(0.0)
	_expect(view.flag.visible and view._aura.visible, "无Unit展台部署结束恢复旗面与范围圈")
	view.begin_visual_death(0.8)
	view._process(0.2)
	_expect(view.flag.visible and not view._aura.visible, "死亡立即停光环但旗面保留随杆下沉")
	view.finish_visual_death()
	view._process(0.1)
	_expect(not view.flag.visible and not view._aura.visible, "死亡动作结束旗面不复现")
	view.reset_pool_visual()
	view._process(0.0)
	_expect(view.flag.visible, "池复用重置死亡状态")
	view.free()
	var ally := _spawn_ready_unit("garen", 0, Vector2(360, 900))
	var enemy := _spawn_ready_unit("garen", 1, Vector2(400, 900))
	var actors: Array = [flag, ally, enemy]
	flag._deploy_timer = 1.0
	AURA.update(actors)
	_expect(ally._effective_attack_speed_multiplier() == 1.0, "部署中不贡献光环")
	flag._deploy_timer = 0.0
	ally.position = flag.position + Vector2(160.0 + ally.body_radius, 0.0)
	AURA.update(actors)
	_expect(ally._effective_attack_speed_multiplier() == 1.25, "身体圆与光环边界接触即生效")
	ally.position.x += 0.1
	AURA.update(actors)
	_expect(ally._effective_attack_speed_multiplier() == 1.0, "身体圆刚离开边界立即失效")
	ally.position = Vector2(360, 900)
	_expect(_main.runtime._deployment_rules.is_card_deploy_position_valid(0, "demacian_standard", Vector2(300, 400)), "军旗可部署到敌方半区")
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.25) and is_equal_approx(enemy._effective_attack_speed_multiplier(), 1.0), "军旗只给友方加速")
	var second := _spawn_ready_unit("demacian_standard", 0, Vector2(240, 900))
	actors.append(second)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.25), "多军旗不叠乘")
	ally.apply_active_buff(1.0, 1.0, 1.0, 1.5)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.5), "光环与主动攻速取最强")
	ally.buffs.clear_family(&"buff")
	flag.apply_stasis(1.0)
	second.apply_stasis(1.0)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.0), "来源凝滞抑制光环")
	flag.control.hard.clear_family(&"stasis")
	flag._tick_active_statuses(1.0)
	flag.stun(1.0)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.25), "眩晕不关闭既有被动光环")
	ally.position = Vector2(600, 900)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.0), "离开范围立即移除加速")
	ally.position = Vector2(360, 900)
	ally.apply_stasis(1.0)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.0), "目标凝滞不贡献增益")
	ally._tick_active_statuses(1.0)
	var skill: Dictionary = CardDB.active_skills_for("demacian_standard")[0]
	enemy.position = flag.position + Vector2(160.0 + enemy.body_radius + 0.1, 0.0)
	_main._active_skill_effect_system.apply(flag, skill)
	_expect(is_equal_approx(enemy.control.slow_multiplier, 1.0), "W中心160范围外不减速")
	flag._tick_active_statuses(3.0)
	ally._tick_active_statuses(3.0)
	enemy.position.x -= 0.1
	_main._active_skill_effect_system.apply(flag, skill)
	_expect(flag.shield_hp == 120 and ally.shield_hp == 120, "圣盾覆盖自身和友军")
	_expect(enemy.shield_hp == 0 and is_equal_approx(enemy.control.slow_multiplier, 0.65), "圣盾只减速敌军且不造成伤害")
	_expect(enemy.hp == enemy.max_hp, "黄金圣盾无伤害")
	ally.take_damage(50)
	_expect(ally.shield_hp == 70 and ally.hp == ally.max_hp, "护盾按通用盾层吸收伤害")
	ally._tick_active_statuses(3.0)
	_expect(ally.shield_hp == 0, "黄金圣盾3秒自然到期")
	flag.take_damage(10000)
	AURA.update(actors)
	_expect(is_equal_approx(ally._effective_attack_speed_multiplier(), 1.0), "死亡来源不保留光环")
	for actor in actors: actor.free()
	flag = _spawn_ready_unit("demacian_standard", 0, Vector2(300, 900))
	for i in 240: flag.sim_tick(0.05)
	_expect(flag.hp == 0, "军旗12秒自然衰血归零")
	flag.free()
	_main.free()
