extends RefCounted
var _harness
var _main: Node2D
var _spells: SpellSystem
func run(harness, main: Node2D) -> void:
	_harness = harness
	_main = main
	_spells = main.get("_spell_system")
	var stats := CardDB.get_card("solar_flare")
	var center := Vector2(360, 800)
	var a: Unit = main._spawn_unit(UnitSpawnRequest.new(1, "garen", center, {"deploy_time_override": 0.0}))
	var b: Unit = main._spawn_unit(UnitSpawnRequest.new(1, "anivia", center + Vector2(90, 0), {"deploy_time_override": 0.0}))
	var ally: Unit = main._spawn_unit(UnitSpawnRequest.new(0, "garen", center, {"deploy_time_override": 0.0}))
	_expect(stats.cost == 2 and stats.active_cost_bonus == 1, "普通2费强化3费")
	_spells.cast(0, stats, center, true)
	var impact: int = _spells.solar_casts[0].impact_tick
	_expect(impact - main.get_authoritative_server_tick() == 18, "0.9秒18Tick")
	_tick(impact - 1)
	_expect(a.control.stun_timer == 0 and a.sunlight_visual() == 0, "落光前无控制标记")
	_tick(impact)
	_expect(a.hp == a.max_hp and b.hp == b.max_hp, "基础法术无伤害")
	_expect(a.control.stun_timer > 1.7 and b.control.stun_timer == 0, "中心眩晕外围不眩晕")
	_expect(b.control.slow_multiplier < 0.21, "外围空军减速80%")
	_expect(a.sunlight_visual() == 2.5 and b.sunlight_visual() == 2.5 and ally.sunlight_visual() == 0, "仅敌军日光")
	a.take_damage(0)
	_expect(a.sunlight_visual() == 2.5, "零伤害不消耗")
	main.combat_service().begin_batch(impact + 1, "sunlight")
	BattleNumbers.hit(a, 10, ally, 0, ally.position)
	BattleNumbers.hit(a, 10, ally, 0, ally.position)
	main.combat_service().commit_batch()
	_expect(a.hp == a.max_hp - 120 and a.sunlight_visual() == 0, "同批两次伤害仅触发一次100额外伤害")
	b.buffs.advance(2.5)
	_expect(b.sunlight_visual() == 0, "日光固定时钟到期")
	a.hp = a.max_hp
	a.buffs.apply(&"sunlight", &"solar_flare", 2.5, {"damage": 100.0})
	a.buffs.advance(1.0)
	a.buffs.apply(&"sunlight", &"solar_flare", 2.5, {"damage": 100.0})
	_expect(a.sunlight_visual() == 2.5, "重复日光刷新")
	a.buffs.apply(&"effect_shield", &"test", 5.0, {})
	BattleNumbers.hit(a, 10, ally, 0, ally.position)
	_expect(a.hp == a.max_hp and a.sunlight_visual() == 2.5, "被法术盾拒绝的伤害不消费已有日光")
	a.buffs.apply(&"damage_reduction", &"test", 2.0, {"reduction": 0.5})
	BattleNumbers.hit(a, 10, ally, 0, ally.position)
	_expect(a.hp == a.max_hp - 55 and a.sunlight_visual() == 0, "日光伤害服从减伤且重复标记不叠加")
	a.buffs.clear_family(&"damage_reduction")
	a.hp = a.max_hp
	a.control.clear_on_death()
	a.buffs.apply(&"effect_shield", &"test", 5.0, {})
	_spells.cast(0, stats, center, true)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(a.sunlight_visual() == 0 and a.control.stun_timer == 0, "法术盾抵挡控制及日光")
	a.apply_stasis(2.0)
	_spells.cast(0, stats, center, true)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(a.sunlight_visual() == 0, "凝滞拒绝标记")
	_spells.cast(0, stats, center, true)
	_spells.clear()
	_tick(main.get_authoritative_server_tick() + 30)
	_expect(_spells.solar_casts.is_empty(), "清场取消待落光")
	_spells.show_flight(999, "solar_flare", center, center, 100, 0, 18)
	_expect(_spells.solar_casts.is_empty() and _spells.solar_effects.size() == 1, "客户端事件仅创建画面")
	_spells.clear()
	for u in [a,b,ally]: u.free()
	var building: Unit = main._spawn_unit(UnitSpawnRequest.new(1, "target_dummy", center, {"deploy_time_override": 0.0}))
	_spells.cast(0, stats, center, true)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(is_equal_approx(building.control.stun_timer, 1.75) and building.sunlight_visual() == 2.5, "建筑卡中心眩晕并施加日光")
	building.take_damage(10)
	_expect(building.hp == building.max_hp - 110 and building.sunlight_visual() == 0, "建筑卡日光保留100全额伤害")
	building.control.clear_on_death()
	_spells.cast(1, stats, center)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(building.control.stun_timer == 0, "友方建筑不眩晕")
	_spells.cast(0, stats, center + Vector2(70 + building.body_radius, 0), true)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(building.control.stun_timer == 0 and building.control.slow_timer == 0 and building.sunlight_visual() == 2.5, "外围建筑施加日光但不受减速眩晕")
	building.buffs.apply(&"effect_shield", &"test", 5.0, {})
	_spells.cast(0, stats, center)
	_tick(_spells.solar_casts[0].impact_tick)
	_expect(building.control.stun_timer == 0, "建筑法术盾仍抵挡中心眩晕")
	building.free()
	for tower in main.world.towers_snapshot():
		var hp: float = tower.hp
		_spells.cast(1-tower.team, stats, tower.position, true)
		_tick(_spells.solar_casts[0].impact_tick)
		_expect(tower.hp == hp, "塔与水晶不受伤")
		_expect(tower.sunlight_visual() == 2.5, "防御塔与水晶获得日光")
		tower.take_damage(0)
		_expect(tower.sunlight_visual() == 2.5, "塔零伤害不消费日光")
		main.combat_service().begin_batch(main.get_authoritative_server_tick(), "tower_sunlight")
		tower.take_damage(10)
		tower.take_damage(10)
		main.combat_service().commit_batch()
		_expect(tower.hp == hp - 50 and tower.sunlight_visual() == 0, "塔与水晶同批只消费一次30伤害")
		tower.hp = hp
		if tower.is_king:
			_expect(tower.control.stun_timer == 0 and not tower.has_visible_stun(), "水晶免疫中心眩晕")
			tower.stun(2.0)
			tower.freeze(2.0)
			tower.apply_stasis(2.0)
			_expect(tower.control.stun_timer == 0 and tower.frozen_timer == 0 and not CombatInteraction.in_stasis(tower), "水晶统一免疫眩晕冰冻凝滞入口")
			tower.apply_network_state(hp, tower.activated, true, 0.0, 0.0, true, true)
			_expect(tower.control.stun_timer == 0 and tower.frozen_timer == 0 and not CombatInteraction.in_stasis(tower), "水晶副本同样拒绝所有控制标志")
		else:
			_expect(is_equal_approx(tower.control.stun_timer, 1.75) and tower.has_visible_stun(), "防御塔中心眩晕并显示通用标识")
		tower.control.tick_hard_controls(1.75)
		_expect(tower.control.stun_timer == 0, "建筑眩晕按时结束")
		_spells.cast(1-tower.team, stats, tower.position + Vector2(70 + tower.body_radius, 0), true)
		_tick(_spells.solar_casts[0].impact_tick)
		_expect(tower.control.stun_timer == 0, "外围防御塔及水晶不眩晕")
		_expect(tower.sunlight_visual() == 2.5, "外围塔与水晶同样获得日光")
		var snapshot: Array = main.get("_snapshot_system")._tower_snapshot_payload(tower)
		_expect(snapshot.size() == NetworkSnapshotSystem.TOWER_PAYLOAD_SIZE and snapshot[NetworkSnapshotSystem.T_SUNLIGHT] == 2.5, "塔快照携带日光剩余时间")
		tower.prepare_statuses(2.5)
		_expect(tower.sunlight_visual() == 0, "塔日光按固定时钟到期")
		tower.sunlight_marks.apply(&"sunlight", &"solar_flare", 2.5, {"damage":30.0})
		tower.add_shield(100, 5)
		tower.take_damage(10)
		_expect(tower.hp == hp and tower.shield_hp == 60 and tower.sunlight_visual() == 0, "塔护盾吸收基础与日光伤害")
		tower.clear_shields()
		tower.apply_network_state(hp, tower.activated, false, 0, 0, false, false, 1.5)
		_expect(tower.net_sunlight == 1.5 and tower.sunlight_marks.remaining(&"sunlight") == 0, "塔副本标记不建立权威伤害状态")
		_spells.cast(tower.team, stats, tower.position)
		_tick(_spells.solar_casts[0].impact_tick)
		_expect(tower.control.stun_timer == 0, "友方防御塔及水晶不眩晕")
	for field in ["inner_radius", "spell_windup", "slow_multiplier"]:
		var bad := stats.duplicate(true)
		bad[field] = -1
		_expect(not CardDB.VALIDATOR.validate_all({"solar_flare": bad}, false).is_empty(), "拒绝非法字段" + field)
	_spells.clear()
func _tick(tick: int) -> void:
	_main.runtime.set("_sim_tick_id", tick)
	_main.combat_service().begin_batch(tick, "solar_test")
	_spells.tick(0.05)
	_main.combat_service().commit_batch()
func _expect(ok: bool, message: String) -> void:
	_harness._expect(ok, "太阳耀斑：" + message)
