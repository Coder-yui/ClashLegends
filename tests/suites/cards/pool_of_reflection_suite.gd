extends RefCounted
var _harness
var _main: Node2D
var _spells: SpellSystem
func run(harness, main: Node2D) -> void:
	_harness = harness
	_main = main
	_spells = main.get("_spell_system")
	var stats := CardDB.get_card("pool_of_reflection")
	var center := Vector2(360, 800)
	var ally: Unit = main._spawn_unit(UnitSpawnRequest.new(0, "garen", center, {"deploy_time_override": 0.0}))
	var air: Unit = main._spawn_unit(UnitSpawnRequest.new(0, "anivia", center, {"deploy_time_override": 0.0}))
	var enemy: Unit = main._spawn_unit(UnitSpawnRequest.new(1, "garen", center, {"deploy_time_override": 0.0}))
	var building: Unit = main._spawn_unit(UnitSpawnRequest.new(0, "tombstone", center, {"deploy_time_override": 0.0}))
	_expect(stats.cost == 3 and stats.active_cost_bonus == 1, "普通3费强化4费")
	_spells.cast(0, stats, center)
	var first: int = main.get_authoritative_server_tick()
	_expect(ally.shield_hp == 0, "普通落地不提前发盾")
	for t in range(first + 1, first + 21): _tick(t)
	_expect(ally.shield_hp == 60 and air.shield_hp == 60, "20Hz补盾对地空友军生效")
	_expect(enemy.shield_hp == 0 and building.shield_hp == 0, "排除敌方和建筑")
	ally.shields.absorb(30)
	_tick(first + 21)
	_expect(ally.shield_hp == 33, "被消耗后继续补盾")
	air.position = center + Vector2(300, 0)
	_tick(first + 22)
	_expect(air.shield_hp == 63, "离圈停止补盾")
	air.shields.tick(1.0)
	_expect(air.shield_hp == 0, "离圈护盾一秒到期")
	_spells.clear()
	ally.clear_shields()
	_spells.cast(0, stats, center, true)
	_expect(ally.shield_hp == 120, "渲浓落地立即120盾")
	main._audio_manager._tick_attached_units()
	var audio_key: String = main._audio_manager._sustain_key(ally.get_instance_id(), &"pool_shield")
	var shield_player = main._audio_manager._sustain_players.get(audio_key)
	_expect(shield_player != null, "清泉盾持续声由受盾对象持有")
	_expect(is_equal_approx(shield_player.volume_db, -6.0), "获得护盾持续音衰减6dB")
	main._audio_manager._tick_attached_units()
	_expect(main._audio_manager._sustain_players.get(audio_key) == shield_player, "刷新不重播护盾持续声")
	await main.get_tree().physics_frame
	await main.get_tree().process_frame
	main._audio_manager.set_battle_paused(true)
	_expect(shield_player.stream_paused, "暂停同步护盾持续声")
	main._audio_manager.set_battle_paused(false)
	_spells.cast(0, stats, center, true)
	_spells.cast(0, stats, center)
	var start: int = main.get_authoritative_server_tick()
	_tick(start + 1)
	_expect(ally.shield_hp == 243, "重叠区域只补一次")
	for t in range(start + 2, start + 61): _tick(t)
	_expect(ally.shield_hp == 420 and _spells.pool_zones.is_empty(), "两次初始盾加180持续盾，超过旧300上限且60Tick结束")
	_tick(start + 61)
	_expect(ally.shield_hp == 420, "结束不再补盾")
	ally.shields.tick(1.0)
	_expect(not ally.pool_shield_visual(), "结束后清除清泉盾表现")
	main._audio_manager._tick_attached_units()
	_expect(not main._audio_manager._sustain_players.has(audio_key), "失盾立即停止持续声")
	ally.add_shield(500, 10.0, false, &"other")
	_spells.cast(0, stats, center, true)
	_expect(ally.shield_hp == 620, "清泉盾与其他来源盾正常累加")
	_spells.clear()
	ally.clear_shields()
	ally.apply_stasis(2.0)
	_spells.cast(0, stats, center, true)
	_tick(main.get_authoritative_server_tick() + 1)
	_expect(ally.shield_hp == 0, "凝滞拒绝补盾")
	for target in [ally, air, enemy, building]: target.free()
	_spells.clear()
	_expect(_spells.pool_zones.is_empty() and _spells.pool_effects.is_empty(), "清场清除区域和表现")
func _tick(tick: int) -> void:
	_main.runtime._sim_tick_id = tick
	_main.combat_service().begin_batch(tick, "pool_test")
	_spells.tick(0.05)
	_main.combat_service().commit_batch()
func _expect(ok: bool, message: String) -> void:
	_harness._expect(ok, "庇护清泉：" + message)
