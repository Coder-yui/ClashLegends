# Godot 4 编辑器缓存
.godot/
# 本地 Python 工具环境
.venv/
# 导出产物
/builds/*
!/builds/.gdignore
# macOS
.DS_Store

# Godot 项目外的本地素材目录：只保留目录级 .gdignore 标记，素材本身不纳入版本库
/ClashLegends-promo-materials/**
!/ClashLegends-promo-materials/.gdignore
/待开发卡牌美术素材/**
!/待开发卡牌美术素材/.gdignore

# 可再生的 Python 缓存
__pycache__/
*.py[cod]
