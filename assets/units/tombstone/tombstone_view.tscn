[sub_resource type="Shader" id="Shader_tombstone_fog"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix, shadows_disabled;

uniform vec4 fog_color : source_color = vec4(0.004, 0.006, 0.012, 0.92);
uniform vec4 inner_color : source_color = vec4(0.018, 0.055, 0.065, 0.94);
uniform float density : hint_range(0.0, 1.5) = 1.0;
uniform float layer_shape : hint_range(0.0, 1.0) = 0.0;
uniform float layer_seed = 0.0;
uniform float fog_visibility : hint_range(0.0, 1.0) = 1.0;
uniform float disperse : hint_range(0.0, 1.0) = 0.0;

float random_value(vec2 point) {
    return fract(sin(dot(point, vec2(127.1, 311.7))) * 43758.5453);
}

float value_noise(vec2 point) {
    vec2 cell = floor(point);
    vec2 fraction = fract(point);
    fraction = fraction * fraction * (3.0 - 2.0 * fraction);
    float a = random_value(cell);
    float b = random_value(cell + vec2(1.0, 0.0));
    float c = random_value(cell + vec2(0.0, 1.0));
    float d = random_value(cell + vec2(1.0, 1.0));
    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
}

float fog_noise(vec2 point) {
    float result = 0.0;
    float amplitude = 0.55;
    for (int octave = 0; octave < 4; octave++) {
        result += value_noise(point) * amplitude;
        point = point * 2.03 + vec2(4.2, 1.7);
        amplitude *= 0.48;
    }
    return result;
}

void fragment() {
    vec2 centered = UV * 2.0 - vec2(1.0);
    float ground_mask = 1.0 - smoothstep(0.50, 1.0, length(centered * vec2(1.0, 0.88)));
    float vertical_sides = 1.0 - smoothstep(0.42, 1.0, abs(centered.x));
    float vertical_bottom = smoothstep(-1.08, -0.55, centered.y);
    float vertical_top = 1.0 - smoothstep(0.28, 1.0, centered.y);
    float vertical_mask = vertical_sides * vertical_bottom * vertical_top;
    float shape_mask = mix(ground_mask, vertical_mask, layer_shape);

    vec2 drift = vec2(TIME * (0.045 + layer_shape * 0.035), -TIME * (0.09 + layer_shape * 0.08));
    vec2 noise_uv = UV * mix(vec2(3.0), vec2(3.6, 2.5), layer_shape) + drift + layer_seed;
    float broad_noise = fog_noise(noise_uv);
    float fine_noise = value_noise(noise_uv * 3.7 - drift * 1.8);
    float tendrils = smoothstep(0.20, 0.82, broad_noise + fine_noise * 0.20);
    float solid_core = mix(0.76, 0.34, layer_shape);
    float alpha = shape_mask * (solid_core + tendrils * mix(0.28, 0.56, layer_shape));
    alpha *= density * fog_visibility * (1.0 - disperse * 0.20);

    vec3 color = mix(fog_color.rgb, inner_color.rgb, broad_noise * 0.48 + fine_noise * 0.10);
    color = mix(color, vec3(0.025, 0.040, 0.045), disperse * 0.34);
    color += vec3(0.008, 0.018, 0.020) * tendrils;
    ALBEDO = color;
    ALPHA = clamp(alpha, 0.0, 0.96);
}
"

